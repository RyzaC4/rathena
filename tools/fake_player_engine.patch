diff --git a/conf/battle/fake_player.conf b/conf/battle/fake_player.conf
new file mode 100644
index 000000000..796a7112d
--- /dev/null
+++ b/conf/battle/fake_player.conf
@@ -0,0 +1,56 @@
+// Fake Player Engine - central behavior configuration
+// Reload: @reloadfakeplayerdb
+
+fake_player_enable: yes
+
+// Population cap (hardware dependent)
+fake_max_population: 200
+
+// AI brain tick interval (ms) — 1000 = once per second
+fake_ai_tick_rate: 1000
+
+// Scan ranges (cells)
+fake_scan_mob_distance: 15
+fake_scan_item_distance: 10
+
+// Natural walk
+fake_walk_distance_min: 3
+fake_walk_distance_max: 9
+fake_idle_time_min: 1000
+fake_idle_time_max: 3000
+
+// Recovery thresholds (%)
+fake_sit_hp_percent: 30
+fake_sit_sp_percent: 30
+fake_potion_hp_percent: 70
+fake_potion_sp_percent: 70
+fake_potion_heal_amount: 325
+fake_potion_sp_amount: 40
+
+// Loot
+fake_loot_speed: 400
+fake_prioritize_loot: yes
+
+// Social / combat ethics
+fake_anti_ks: yes
+fake_teleport_on_idle_seconds: 7
+
+// Emotes (% chance)
+fake_emote_on_kill_rate: 25
+fake_emote_on_lowhp_rate: 15
+
+// Town hub on death / rebirth
+fake_town_map: prontera
+fake_town_x: 156
+fake_town_y: 180
+
+// Support whisper buff cooldown (ms)
+fake_support_buff_cooldown: 3000
+
+// SQL autosave interval (ms)
+fake_sql_save_interval: 30000
+
+// NLP bridge (optional external Python) — 0 = disabled
+fake_nlp_enable: no
+fake_nlp_host: 127.0.0.1
+fake_nlp_port: 8765
