@@ -0,0 +1,307 @@
+// Copyright (c) rAthena Dev Teams - Licensed under GNU GPL
+
+#include "../fake_player.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+
+#include <common/nullpo.hpp>
+#include <common/random.hpp>
+#include <common/showmsg.hpp>
+#include <common/timer.hpp>
+
+#include "../battle.hpp"
